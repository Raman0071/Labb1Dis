<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<fmt:setLocale value="sv_SE" />
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Labbshoppen</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css">
</head>
<body>
<header>
    <a class="brand" href="${pageContext.request.contextPath}/shop/products">Labbshoppen</a>
    <c:if test="${not empty sessionScope.user}">
        <nav aria-label="Huvudmeny">
            <a href="${pageContext.request.contextPath}/shop/products">Produkter</a>
            <a href="${pageContext.request.contextPath}/shop/cart">Varukorg (<c:out value="${cartView.count}" />)</a>
            <span><c:out value="${sessionScope.user.username}" /></span>
            <form method="post" action="${pageContext.request.contextPath}/shop/logout">
                <input type="hidden" name="csrf" value="${sessionScope.csrf}">
                <button class="secondary" type="submit">Logga ut</button>
            </form>
        </nav>
    </c:if>
</header>
<main>
    <c:if test="${not empty error}"><p class="notice error" role="alert"><c:out value="${error}" /></p></c:if>
    <c:if test="${not empty message}"><p class="notice" role="status"><c:out value="${message}" /></p></c:if>
